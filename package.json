{
  "name": "secure-notes-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "pnpm --filter @secure-notes/core build && pnpm --filter @secure-notes/web build",
    "dev": "pnpm --filter @secure-notes/core build && pnpm --filter @secure-notes/web dev",
    "check": "pnpm --filter @secure-notes/core build && pnpm --filter @secure-notes/web check && tsc -p tsconfig.node.json",
    "test": "pnpm --filter @secure-notes/core build && vitest run",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
